rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Development rules - open access for testing
    // WARNING: These rules allow anyone to read/write your database
    // Change these before deploying to production
    
    match /{document=**} {
      allow read, write: if true;
    }
    
    // Production rules (uncomment below and comment out above for production)
    // Since this app uses localStorage for user IDs without Firebase Auth,
    // you'll need to implement custom authentication or use a different approach
    // for production security.
    
    // match /clips/{clip} {
    //   allow read: if true;
    //   allow create: if request.resource.data.ownerId == request.auth.uid;
    //   allow update, delete: if resource.data.ownerId == request.auth.uid;
    // }
    
    // match /users/{userId} {
    //   allow read: if true;
    //   allow write: if request.auth.uid == userId;
    // }
    
    // match /users/{userId}/{subcollection=**} {
    //   allow read, write: if request.auth.uid == userId;
    // }
    
    // match /reports/{report} {
    //   allow read, write: if request.auth != null;
    // }
  }
}
